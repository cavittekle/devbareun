# DevBareun backup/recovery operator template (v1.4.29)
# This file is for a secured operator workstation or isolated backup runner.
# Do NOT copy DEVBAREUN_BACKUP_DATABASE_URL into Railway web, analysis-worker,
# audit-worker, Vercel or source control. Store real values in the operator's
# secret manager / untracked env file only.
#
# The tools/backup_recovery.py utility deliberately has no production restore
# command. Restores are permitted only into an isolated recovery environment.

# Backup policy shared with production services (no credential values here)
DEVBAREUN_BACKUP_REQUIRED=true
DEVBAREUN_BACKUP_RPO_HOURS=24
DEVBAREUN_BACKUP_RTO_HOURS=8
DEVBAREUN_BACKUP_DRILL_MAX_AGE_DAYS=90
DEVBAREUN_BACKUP_STORAGE_MANIFEST_REQUIRED=true

# Secure PostgreSQL direct connection. Backend/operator scope only.
# This must use a dedicated least-privilege backup role where possible.
DEVBAREUN_BACKUP_DATABASE_URL=postgresql://backup_user:replace_with_password@your-supabase-db-host:5432/postgres

# External encrypted location, never the repository root.
DEVBAREUN_BACKUP_OUTPUT_DIR=/secure/encrypted/devbareun-backups

# Storage inventory requires a Supabase service-role key. It creates an object
# inventory manifest only; it does not download customer files.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key_backup_operator_only
SUPABASE_STORAGE_BUCKET=project-files
SUPABASE_REPORTS_BUCKET=reports

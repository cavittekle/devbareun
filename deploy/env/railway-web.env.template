# DevBareun Railway web service production template
# Copy values into Railway. Replace every placeholder in the provider dashboard.
# Root Directory: backend
# Start Command: python -m uvicorn app.main:app --host 0.0.0.0 --port $PORT
# Do not commit a filled version of this file.

# Runtime
DEVBAREUN_ENV=production
APP_ENV=production
DEVBAREUN_VERSION=1.4.31-billing-lifecycle
PUBLIC_SITE_URL=https://your-public-site.example
DEVBAREUN_ALLOWED_ORIGINS=https://your-public-site.example
CORS_ALLOWED_ORIGINS=https://your-public-site.example
DEVBAREUN_CHECKOUT_ALLOWED_ORIGINS=https://your-public-site.example
FRONTEND_PUBLIC_API_BASE_URL=https://your-railway-api.example

# Upload limits
DEVBAREUN_MAX_FILES=12
DEVBAREUN_MAX_FILE_MB=30
DEVBAREUN_MAX_TOTAL_MB=120
DEVBAREUN_MAX_UPLOAD_BYTES=104857600

# Error telemetry (backend/worker only; Sentry receives sanitized synthetic events)
DEVBAREUN_ERROR_TELEMETRY_MODE=sentry
DEVBAREUN_REQUIRE_ERROR_TELEMETRY=true
DEVBAREUN_SENTRY_DSN=https://replace_with_sentry_dsn@example.ingest.sentry.io/0
DEVBAREUN_REQUEST_LOGS_ENABLED=true


# Backup / disaster-recovery policy (actual backup credentials belong only to a secure operator)
DEVBAREUN_BACKUP_REQUIRED=true
DEVBAREUN_BACKUP_RPO_HOURS=24
DEVBAREUN_BACKUP_RTO_HOURS=8
DEVBAREUN_BACKUP_DRILL_MAX_AGE_DAYS=90
DEVBAREUN_BACKUP_STORAGE_MANIFEST_REQUIRED=true


# Privacy and data lifecycle request policy (Railway only; no automatic destructive purge)
DEVBAREUN_SOFT_DELETE_RETENTION_DAYS=30
DEVBAREUN_ERASURE_GRACE_DAYS=14
DEVBAREUN_PRIVACY_EXPORT_REQUEST_TTL_DAYS=7
DEVBAREUN_TEAM_INVITE_TTL_HOURS=72
DEVBAREUN_AUTO_PURGE_ENABLED=false

# Production security
DEVBAREUN_PRODUCTION_SECURITY=true
DEVBAREUN_ENABLE_DEV_AUTH=false
DEVBAREUN_ENABLE_LOCAL_STORE=false
DEVBAREUN_ENABLE_MOCK_PAYMENT=false
DEVBAREUN_ENABLE_PILOT_LOGIN=false
DEVBAREUN_ENABLE_PILOT_CHECKOUT=false
DEVBAREUN_ALLOW_EPHEMERAL_PROJECT_UPLOAD=false
DEVBAREUN_ALLOW_LEGACY_PROJECT_ROUTES=false
DEVBAREUN_DISABLE_DOCS=true
DEVBAREUN_REQUIRE_CSRF_TOKEN=true

# Admin access
DEVBAREUN_ADMIN_EMAILS=admin@your-public-site.example
DEVBAREUN_ALLOW_ADMIN_EMAIL_FALLBACK=false
DEVBAREUN_ALLOW_DEVBAREUN_DOMAIN_ADMINS=false

# Rate limits
DEVBAREUN_RATE_LIMIT_ENABLED=true
DEVBAREUN_ALLOW_IN_MEMORY_RATE_LIMIT=false
DEVBAREUN_RATE_LIMIT_WINDOW_SECONDS=60
DEVBAREUN_RATE_LIMIT_DEFAULT_PER_MIN=180
DEVBAREUN_RATE_LIMIT_AUTH_PER_MIN=20
DEVBAREUN_RATE_LIMIT_UPLOAD_PER_MIN=30
DEVBAREUN_RATE_LIMIT_ANALYSIS_PER_MIN=20
DEVBAREUN_RATE_LIMIT_EXPORT_PER_MIN=60
DEVBAREUN_RATE_LIMIT_ADMIN_PER_MIN=120
DEVBAREUN_RATE_LIMIT_WEBHOOK_PER_MIN=100
UPSTASH_REDIS_REST_URL=https://replace-with-upstash-rest-url.example
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_rest_token_backend_only

# Analysis execution
DEVBAREUN_ANALYSIS_JOB_MODE=worker
DEVBAREUN_ANALYSIS_JOB_MAX_ATTEMPTS=3
DEVBAREUN_ANALYSIS_WORKER_INTERVAL=10
DEVBAREUN_ANALYSIS_WORKER_BATCH_SIZE=1

# Guest result links
DEVBAREUN_GUEST_RESULT_DAYS=7
DEVBAREUN_GUEST_RESULT_MAX_DAYS=7

# Supabase (Railway/private service scope)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key_backend_only
SUPABASE_JWT_SECRET=replace_with_supabase_jwt_secret_if_required
SUPABASE_STORAGE_BUCKET=project-files
SUPABASE_REPORTS_BUCKET=reports

# Lemon Squeezy (backend only)
DEVBAREUN_PAYMENT_PROVIDER=lemonsqueezy
LEMON_SQUEEZY_API_KEY=replace_with_lemonsqueezy_api_key_backend_only
LEMON_SQUEEZY_STORE_ID=replace_with_lemonsqueezy_store_id
LEMON_SQUEEZY_WEBHOOK_SECRET=replace_with_lemonsqueezy_webhook_secret_backend_only
LEMON_SQUEEZY_SINGLE_VARIANT_ID=replace_with_single_variant_id
LEMON_SQUEEZY_PLUS_VARIANT_ID=replace_with_plus_variant_id
LEMON_SQUEEZY_PRO_VARIANT_ID=replace_with_pro_variant_id
# Retry budget for verified payment webhook processing; 1-20.
DEVBAREUN_PAYMENT_WEBHOOK_MAX_ATTEMPTS=5

# Checkout redirects
FRONTEND_SUCCESS_URL=https://your-public-site.example/result-dashboard.html?payment=success&project_id={project_id}&session_id={CHECKOUT_SESSION_ID}
FRONTEND_CANCEL_URL=https://your-public-site.example/?payment=cancelled&project_id={project_id}

# Optional assisted mapping remains disabled unless explicitly configured.
OPENAI_MAPPING_ENABLED=false
OPENAI_MAPPING_MODEL=gpt-4.1-mini
OPENAI_MAPPING_CONFIDENCE_THRESHOLD=85
OPENAI_API_KEY=

# Optional PDF font overrides
DEVBAREUN_PDF_FONT=
DEVBAREUN_PDF_FONT_BOLD=
DEVBAREUN_ANALYSIS_JOB_HEARTBEAT_SECONDS=60
DEVBAREUN_ANALYSIS_WORKER_STATUS_STALE_SECONDS=90

# Source-file checksum verification
DEVBAREUN_REQUIRE_UPLOAD_CHECKSUM=true
# Upload security screening (deterministic parser-admission gate; not antivirus)
DEVBAREUN_MAX_OFFICE_ARCHIVE_ENTRIES=2000
DEVBAREUN_MAX_OFFICE_UNCOMPRESSED_BYTES=251658240
DEVBAREUN_MAX_OFFICE_COMPRESSION_RATIO=500
DEVBAREUN_BLOCK_MACRO_ENABLED_UPLOADS=false
DEVBAREUN_BLOCK_ACTIVE_PDF_CONTENT=false


# v1.4.25 external audit archive (Railway only; never Vercel)
DEVBAREUN_AUDIT_ARCHIVE_MODE=webhook
DEVBAREUN_AUDIT_ARCHIVE_WEBHOOK_URL=https://replace_with_external_audit_archive_endpoint
DEVBAREUN_AUDIT_ARCHIVE_WEBHOOK_SECRET=replace_with_audit_archive_hmac_secret_backend_only
DEVBAREUN_AUDIT_ARCHIVE_MAX_ATTEMPTS=8
DEVBAREUN_AUDIT_ARCHIVE_BATCH_SIZE=25
DEVBAREUN_AUDIT_ARCHIVE_LEASE_SECONDS=90
DEVBAREUN_AUDIT_ARCHIVE_TIMEOUT_SECONDS=10
DEVBAREUN_AUDIT_ARCHIVE_WORKER_INTERVAL=15
DEVBAREUN_AUDIT_ARCHIVE_WORKER_STATUS_STALE_SECONDS=90

# DevBareun Frontend Public Environment Example
# Target platform: Vercel
# Required Vercel project setting:
#   Root Directory = frontend
#
# This static frontend uses js/devbareun-api.js defaults at runtime. These
# public values are kept as deployment documentation and for future build steps.
# Never add backend-only secrets here.

VITE_PUBLIC_SITE_URL=https://devbareun.com
VITE_API_BASE_URL=https://devbareun-production.up.railway.app
VITE_API_URL=https://devbareun-production.up.railway.app
VITE_DEVBAREUN_API_BASE_URL=https://devbareun-production.up.railway.app

# Public Supabase browser values only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_supabase_anon_key

# Do not add these to Vercel/frontend:
# SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_JWT_SECRET
# LEMON_SQUEEZY_API_KEY
# LEMON_SQUEEZY_WEBHOOK_SECRET

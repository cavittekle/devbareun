{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: https:; script-src 'self'; style-src 'self'; connect-src 'self' https://*.supabase.co https://*.railway.app https://*.up.railway.app https://api.lemonsqueezy.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/dashboard.html",
      "destination": "/workspace/",
      "permanent": false
    },
    {
      "source": "/upload.html",
      "destination": "/workspace/?view=upload",
      "permanent": false
    },
    {
      "source": "/projects.html",
      "destination": "/workspace/?view=projects",
      "permanent": false
    },
    {
      "source": "/project-detail.html",
      "destination": "/workspace/?view=projects",
      "permanent": false
    },
    {
      "source": "/reports.html",
      "destination": "/workspace/?view=reports",
      "permanent": false
    },
    {
      "source": "/billing.html",
      "destination": "/workspace/?view=billing",
      "permanent": false
    },
    {
      "source": "/settings.html",
      "destination": "/workspace/?view=settings",
      "permanent": false
    },
    {
      "source": "/login.html",
      "destination": "/workspace/?view=login",
      "permanent": false
    },
    {
      "source": "/register.html",
      "destination": "/workspace/?view=register",
      "permanent": false
    },
    {
      "source": "/checkout.html",
      "destination": "/workspace/?view=checkout",
      "permanent": false
    },
    {
      "source": "/payment-success.html",
      "destination": "/workspace/?view=payment-success",
      "permanent": false
    },
    {
      "source": "/payment-failed.html",
      "destination": "/workspace/?view=payment-failed",
      "permanent": false
    },
    {
      "source": "/profile.html",
      "destination": "/workspace/?view=settings",
      "permanent": false
    },
    {
      "source": "/analysis-view.html",
      "destination": "/workspace/?view=result",
      "permanent": false
    },
    {
      "source": "/result-dashboard.html",
      "destination": "/workspace/?view=result",
      "permanent": false
    },
    {
      "source": "/guest-result.html",
      "destination": "/workspace/?view=guest-result",
      "permanent": false
    },
    {
      "source": "/single-project.html",
      "destination": "/index.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/workspace/index.html"
    },
    {
      "source": "/register",
      "destination": "/workspace/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/workspace/index.html"
    },
    {
      "source": "/workspace",
      "destination": "/workspace/index.html"
    },
    {
      "source": "/workspace/:path*",
      "destination": "/workspace/index.html"
    },
    {
      "source": "/upload",
      "destination": "/workspace/index.html"
    },
    {
      "source": "/projects",
      "destination": "/workspace/index.html"
    },
    {
      "source": "/projects/:id",
      "destination": "/workspace/index.html"
    },
    {
      "source": "/reports",
      "destination": "/workspace/index.html"
    },
    {
      "source": "/billing",
      "destination": "/workspace/index.html"
    },
    {
      "source": "/settings",
      "destination": "/workspace/index.html"
    },
    {
      "source": "/super-admin",
      "destination": "/admin.html"
    },
    {
      "source": "/super-admin/login",
      "destination": "/admin.html"
    }
  ]
}

# DevBareun backend environment example
DEVBAREUN_ALLOWED_ORIGINS=https://devbareun.com,https://www.devbareun.com,http://localhost:3000,http://localhost:5173,http://localhost:8000
DEVBAREUN_MAX_FILES=12
DEVBAREUN_MAX_FILE_MB=30
DEVBAREUN_MAX_TOTAL_MB=120

# Pilot-only local/testing unlock. Set false in production when Stripe is configured.
DEVBAREUN_ENABLE_MOCK_PAYMENT=true

# Optional Stripe Checkout integration
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
DEVBAREUN_STRIPE_AMOUNT_CENTS=4900
DEVBAREUN_STRIPE_CURRENCY=usd
FRONTEND_SUCCESS_URL=https://devbareun.com/result-dashboard.html?payment=success&project_id={project_id}&session_id={CHECKOUT_SESSION_ID}
FRONTEND_CANCEL_URL=https://devbareun.com/?payment=cancelled&project_id={project_id}

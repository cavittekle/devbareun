{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "python -m app.audit_archive_worker --loop --interval ${DEVBAREUN_AUDIT_ARCHIVE_WORKER_INTERVAL:-15} --batch-size ${DEVBAREUN_AUDIT_ARCHIVE_BATCH_SIZE:-25}",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

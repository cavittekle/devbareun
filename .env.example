# DevBareun root environment note
#
# The repository root is not a runtime/deploy target.
# Do not put production secrets here.
#
# Vercel frontend variables:
#   copy from frontend/.env.example
#
# Railway backend variables:
#   copy from backend/.env.example
#
# Supabase service role keys, payment API keys, webhook secrets, database
# passwords, and JWT secrets must only be configured in Railway or the relevant
# provider dashboard. They must never be committed.

# Backup / disaster-recovery policy (actual backup credentials belong only to a secure operator)
DEVBAREUN_BACKUP_REQUIRED=true
DEVBAREUN_BACKUP_RPO_HOURS=24
DEVBAREUN_BACKUP_RTO_HOURS=8
DEVBAREUN_BACKUP_DRILL_MAX_AGE_DAYS=90
DEVBAREUN_BACKUP_STORAGE_MANIFEST_REQUIRED=true

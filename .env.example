# DevBareun Environment Template
# Do not put real secrets in this file.
# Copy this file to .env locally and fill values only in local/deployment environments.
# Never commit real .env files.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_NAME=DevBareun
APP_ENV=development
DEVBAREUN_ENV=development
DEVBAREUN_VERSION=1.4.0-production-saas-core
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000
PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Frontend public variables
# Only public-safe keys should use NEXT_PUBLIC_ or VITE_ prefixes.
# Never expose service role keys, JWT secrets, database passwords, or payment secrets.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

VITE_APP_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000
DEVBAREUN_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4173,http://127.0.0.1:4173
DEVBAREUN_CHECKOUT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4173,http://127.0.0.1:4173

# ---------------------------------------------------------------------------
# DevBareun runtime/security flags
# Production should keep all unsafe pilot/mock flags disabled.
# ---------------------------------------------------------------------------
DEVBAREUN_PRODUCTION_SECURITY=false
DEVBAREUN_ENABLE_DEV_AUTH=false
DEVBAREUN_ENABLE_LOCAL_STORE=false
DEVBAREUN_ENABLE_MOCK_PAYMENT=false
DEVBAREUN_ENABLE_PILOT_LOGIN=false
DEVBAREUN_ENABLE_PILOT_CHECKOUT=false
DEVBAREUN_ALLOW_UNSIGNED_STRIPE_WEBHOOK=false
DEVBAREUN_DISABLE_DOCS=false
DEVBAREUN_MAX_FILES=12
DEVBAREUN_MAX_FILE_MB=30
DEVBAREUN_MAX_TOTAL_MB=120
DEVBAREUN_MAX_UPLOAD_BYTES=104857600
DEVBAREUN_ADMIN_EMAILS=
DEVBAREUN_ALLOW_ADMIN_EMAIL_FALLBACK=false
DEVBAREUN_ALLOW_DEVBAREUN_DOMAIN_ADMINS=false
DEVBAREUN_RATE_LIMIT_ENABLED=true
DEVBAREUN_RATE_LIMIT_WINDOW_SECONDS=60
DEVBAREUN_RATE_LIMIT_DEFAULT_PER_MIN=180
DEVBAREUN_RATE_LIMIT_AUTH_PER_MIN=20
DEVBAREUN_RATE_LIMIT_UPLOAD_PER_MIN=30
DEVBAREUN_RATE_LIMIT_ANALYSIS_PER_MIN=20
DEVBAREUN_RATE_LIMIT_EXPORT_PER_MIN=60
DEVBAREUN_RATE_LIMIT_ADMIN_PER_MIN=120
DEVBAREUN_RATE_LIMIT_WEBHOOK_PER_MIN=100
DEVBAREUN_GUEST_RESULT_DAYS=7
DEVBAREUN_GUEST_RESULT_MAX_DAYS=7

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_REST_URL=
SUPABASE_API_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=project-files
SUPABASE_REPORTS_BUCKET=reports

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=
SESSION_SECRET=
AUTH_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# -----------------------------------------------------------------------------
# Payments
# Use a payment abstraction layer in code.
# Do not hardcode payment-provider business logic directly into UI.
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=lemon_squeezy
DEVBAREUN_PAYMENT_PROVIDER=lemonsqueezy
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_SINGLE_VARIANT_ID=
LEMON_SQUEEZY_PLUS_VARIANT_ID=
LEMON_SQUEEZY_PRO_VARIANT_ID=
LEMON_SQUEEZY_SUCCESS_URL=http://localhost:3000/payment/success
LEMON_SQUEEZY_CANCEL_URL=http://localhost:3000/pricing

# Optional legacy Stripe support. Leave empty unless Stripe is enabled again.
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SINGLE_PROJECT_PRICE_ID=
STRIPE_PLUS_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@devbareun.com

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=supabase
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Export / Reports
# -----------------------------------------------------------------------------
REPORT_STORAGE_PROVIDER=supabase
PDF_EXPORT_ENABLED=true
EXCEL_EXPORT_ENABLED=true
REPORT_EXPIRY_DAYS=30

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# -----------------------------------------------------------------------------
# Deployment identifiers
# -----------------------------------------------------------------------------
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
RAILWAY_SERVICE_ID=
RAILWAY_PROJECT_ID=

# -----------------------------------------------------------------------------
# Monitoring / Logging
# -----------------------------------------------------------------------------
SENTRY_DSN=
ANALYTICS_ENABLED=false
